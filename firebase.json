{
  "hosting": [
    {
      "target": "wedding",
      "public": "wedding",
      "ignore": [
        "tests/**",
        "**/.git/**",
        "**/node_modules/**",
        "_headers",
        "README.md"
      ],
      "headers": [
        {
          "source": "/@(agent-manifest.json|marrow_point_wedding.network.json|links.json|agent-mcp.json)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/.well-known/@(nsdeploy.json|nsdeploy-agent.json)",
          "headers": [
            {
              "key": "Access-Control-Allow-Origin",
              "value": "*"
            }
          ]
        },
        {
          "source": "/runtime/sandbox-worker.js",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; script-src blob:; connect-src 'none'; worker-src 'none'"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|json|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
